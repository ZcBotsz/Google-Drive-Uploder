# ─────────────────────────────────────────────────────────────────────────────
#  DriveUp · environment
#  Copy to `.env`, then fill in the blanks. EVERY value here is a placeholder
#  or a safe default — no real secrets ever live in this file.
#  Only BOT_TOKEN, OWNER_ID, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
#  TOKEN_ENC_KEY, SESSION_SECRET and PUBLIC_URL are required to boot.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram ────────────────────────────────────────────────────────────────
# Token from @BotFather → /newbot → "Use this token to access the HTTP API".
# Legacy alias accepted by the code: TELEGRAM_BOT_TOKEN
BOT_TOKEN=123456789:AAExampleTokenReplaceMeWithYourOwnFromBotFather
# Your numeric Telegram id (DM @userinfobot). This account becomes the owner.
OWNER_ID=100000000
# Comma-separated extra admins (support role gets read-only tools).
ADMIN_IDS=
# Without the @, e.g. DriveUpBot. Used to build the "Open Studio" link.
BOT_USERNAME=YourDriveUpBot
# Channels a user must join before using the bot. Format: @name or -100id,
# comma-separated, up to 3. Leave empty to disable the check entirely.
FORCE_SUB_CHANNELS=
# Custom Bot API server. Leave TELEGRAM_API_URL empty to use the cloud API.
#  ⚠ The cloud API caps downloads at 20 MB — getFile() refuses anything larger,
#    so files above 20 MB are rejected at intake with a clear message.
#  To accept up to 2000 MB, run your own local Bot API server:
#    docker run -d -p 8081:8081 ghcr.io/gramiojs/telegram-bot-api:latest \
#      --api-id=$API_ID --api-hash=$API_HASH --local
#    TELEGRAM_API_URL=http://127.0.0.1:8081
# On Render, the Blueprint fills both host values from the private service.
# With a manually-created/renamed service, set both to its private hostname:8081.
# API_ID/API_HASH alone DO NOT enable the local API; this URL is the switch.
TELEGRAM_API_URL=
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
# Only when the Bot API server's disk is NOT readable from this container
# (e.g. two separate Railway services). Point this at the server's bundled
# file endpoint (gramiojs image with FILE_SERVER=1, token-less URLs).
#   TELEGRAM_FILES_URL=http://tg-bot-api.railway.internal:8080
TELEGRAM_FILES_URL=
# Directory the server stores files in (its --dir). Needed to turn an
# absolute file_path into a file-server URL.
TELEGRAM_WORK_DIR=/var/lib/telegram-bot-api

# ── Web server ──────────────────────────────────────────────────────────────
# Public https URL of this app. Telegram Mini-Apps REQUIRE https.
# Local dev: http://127.0.0.1:8080
PUBLIC_URL=https://driveup.example.com
HOST=0.0.0.0
PORT=8080
# 32+ random chars — signs the Studio session cookie.
# Generate with:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-me-with-48-random-url-safe-characters-xxxxxxxx
# Serve the browser Studio. Set to false for a bot-only deployment.
PUBLIC_STUDIO=true

# ── Google OAuth ────────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client.
# Type "Web application", and add the exact redirect URI:
#   <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=1234567890-abcdefghijklmnop.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-replace-with-your-own-client-secret
GOOGLE_REDIRECT_URI=https://driveup.example.com/auth/google/callback
# file  → drive.file  (only files this app created — lightest consent screen)
#        Users must pick "⌂ My Drive" and let DriveUp create the folder; picking
#        an EXISTING folder fails with 403 PERMISSION_DENIED by Google's design.
# full  → drive       (sees the whole Drive; needed for "pick any folder")
DRIVE_SCOPE_MODE=file
# Optional: Google Picker key (Browser key) if you enable the in-Studio picker.
PICKER_API_KEY=
# Only change for tests. Real deployments must leave this unset.
GOOGLE_API_BASE=https://www.googleapis.com

# ── Encryption & storage ────────────────────────────────────────────────────
# Fernet key for the stored OAuth refresh tokens. Tokens are useless to an
# attacker without this, so keep it out of git.
# Generate with:  python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=replace-me-with-a-44-char-fernet-key-base64-xxxxxxxxx=
# SQLite file. On Render/Railway mount a disk here (e.g. /data/driveup.db).
DB_PATH=./data/driveup.db
# Scratch space for UPLOAD_MODE=disk|auto. Needs room for the largest file.
TEMP_DIR=./data/tmp
DOWNLOAD_DIR=./data/downloads

# ── Upload engine ───────────────────────────────────────────────────────────
# auto → stream files >32 MiB straight from Telegram to Drive (default)
# stream → always stream · disk → always download first (safest, slower)
UPLOAD_MODE=auto
# Drive requires a multiple of 256 KiB. 8 MiB is the sweet spot.
UPLOAD_CHUNK_MB=8
# Telegram → disk read size, in KiB.
DOWNLOAD_CHUNK_KB=256
# Highest simultaneous uploads across the whole server / per single user.
MAX_GLOBAL_UPLOADS=4
MAX_USER_UPLOADS=2
# Google's own ceiling is 750 GB per account per day.
DRIVE_DAILY_QUOTA_GB=750

# ── Quotas & plans ──────────────────────────────────────────────────────────
# Free-tier defaults, applied before a plan is granted.
DEFAULT_MAX_FILE_MB=2000
DEFAULT_DAILY_GB=5
PLAN_PRICE_TEXT=₹99 / month
# Plan table is seeded on first boot; edit it later from the admin panel.

# ── Behaviour ───────────────────────────────────────────────────────────────
# classic | striped | glow | segmented — the animated progress card style.
PROGRESS_STYLE=glow
# true → every card's emoji animate. 36 verified custom-emoji ids ship inside
# driveup/bot/ui/emoji_ids.py: 7 animate for EVERY viewer, the other 29 for
# Telegram Premium viewers; everyone else still sees the plain character, so a
# stale id can never break a message. The admin panel's
# Settings → Animated emoji switch overrides this variable at runtime.
ENABLE_ANIMATED_EMOJI=true
DEFAULT_LANG=en
DEFAULT_TIMEZONE=Asia/Kolkata
SUPPORT_CONTACT=@ZCQXx
BRAND_NAME=ZC Drive Uploader
MAINTENANCE=false

# ── Logging channels (optional) ─────────────────────────────────────────────
# Where upload/audit events go. Leave empty to stay silent.
LOG_CHANNEL_ID=
# Where lock/unlock/ban notices go. Falls back to LOG_CHANNEL_ID.
LOCK_CHANNEL_ID=
# Where copies of every uploaded file are dumped (mirror channel). Optional.
DUMP_CHANNEL_ID=

# ── Admin panel & safety ────────────────────────────────────────────────────
# Re-authenticate after this many idle minutes in the panel.
ADMIN_IDLE_MINUTES=10
# Optional second password gate for admin routes; configure as a platform secret.
ADMIN_PASSWORD=
# A lock applied to a user whose uploads keep failing.
AUTO_LOCK_LIMIT=10
AUTO_LOCK_MINUTES=60
AUTO_LOCK_WINDOW=180
# Default lock length when an admin does not type one.
LOCK_DEFAULT_MINUTES=60
# A download that moves slower than this for STALL_SECONDS is retried.
STALL_SECONDS=120
# Advanced: upload progress from a user account instead of the bot.

# ── Link (direct-URL) uploads ───────────────────────────────────────────────
# A user can paste a direct http(s) link and it streams straight into Drive
# without touching Telegram or the disk. Private, loopback and metadata
# addresses are refused, and every redirect is re-checked.
# Set to 0 to turn the feature off entirely.
URL_UPLOAD_ENABLED=1
# Largest link download we will attempt, in MB. Keep it at or below your plan
# ceiling; a link is refused as soon as the server advertises more than this.
URL_UPLOAD_MAX_MB=2000

# ── Animation ───────────────────────────────────────────────────────────────
# How often the live progress card is redrawn, in seconds. 0.5 gives a smooth
# spinner and moving bars without hitting Telegram's edit limits. The floor is
# 0.25 — anything faster gets the bot throttled.
PROGRESS_TICK=0.5
